{$SITE_ADDRESS} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    -Server
  }
  @oidc path /api/v1/auth/oidc/*
  @ordinary not path /api/v1/auth/oidc/*
  header @oidc Referrer-Policy no-referrer
  header @ordinary Referrer-Policy strict-origin-when-cross-origin
  reverse_proxy app:3000
}
