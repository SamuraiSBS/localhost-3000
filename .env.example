# Prefer python scripts/configure_local.py; this template contains no working credentials.
COMPOSE_PROJECT_NAME=localhost-3000
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
SITE_ADDRESS=:80
PUBLIC_ORIGIN=http://127.0.0.1:8080
APP_LOGIN=
# Quote Argon2 hashes with single quotes to preserve dollar signs in Compose env files.
APP_PASSWORD_HASH=''
METRICS_TOKEN=
METRICS_TOKEN_FILE=./.state/local/metrics-token
APP_IMAGE=localhost-3000:local
